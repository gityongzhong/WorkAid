{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkAid",
  "version": "3.3.1",
  "identifier": "com.workaid.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "WorkAid",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/workaid-cli/workaid-cli.exe": "workaid-cli/workaid-cli.exe",
      "../../dist/workaid-cli/_internal/": "workaid-cli/_internal/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
